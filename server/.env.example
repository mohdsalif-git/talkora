PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27017/talkora

# Optional TURN relay for NAT traversal (audio calls behind symmetric NATs).
# All three must be set together; otherwise TURN is omitted and STUN/direct is used.
# TURN_URLS=turn:your-turn-server:3478,turns:your-turn-server:5349?transport=tcp
# TURN_USERNAME=your-turn-username
# TURN_CREDENTIAL=your-turn-credential
